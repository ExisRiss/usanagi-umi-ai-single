{
  "name": "usanagi-umi-ai",
  "version": "10.1.0",
  "description": "Usanagi Umi AI — WhatsApp multi-device bot with 792 integrated plugins and Usanagi Umi AI compatibility",
  "main": "main.js",
  "type": "module",
  "directories": {
    "lib": "lib",
    "plugins": "plugins"
  },
  "scripts": {
    "start": "node scripts/boot.js",
    "tunnel-start": "set -a; [ -f ./.tunnel.env ] && . ./.tunnel.env; [ -f ./.backup-export.env ] && { chmod 600 ./.backup-export.env 2>/dev/null || true; . ./.backup-export.env; }; [ -f ./.error-report.env ] && { chmod 600 ./.error-report.env 2>/dev/null || true; . ./.error-report.env; }; set +a; chmod 700 ./cloudflared; ./cloudflared tunnel --no-autoupdate run --token \"$CLOUDFLARE_TUNNEL_TOKEN\" & tunnel_pid=$!; trap 'kill \"$tunnel_pid\" 2>/dev/null; wait' INT TERM EXIT; node scripts/boot.js",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js",
    "test:auto-ai": "node --test tests/auto-ai.test.mjs tests/agent-settings.test.mjs && node --loader ./tests/mock-native-loader.mjs --test tests/native-dispatch.test.mjs",
    "backup:worker": "node scripts/backup-worker.js",
    "backup:once": "node scripts/backup-worker.js --once",
    "test:backup": "node --test tests/backup/"
  },
  "author": "AlzRiss × Arena",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@bochilteam/scraper": "^5.0.1",
    "@elainaa/tls": "^1.0.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hapi/boom": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@rexxhayanasi/elaina-baileys": "^1.4.3",
    "archiver": "^7.0.1",
    "awesome-phonenumber": "^5.10.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^11.10.0",
    "canvafy": "^7.2.1",
    "chalk": "^5.3.0",
    "cheerio": "1.0.0-rc.12",
    "chokidar": "^4.0.3",
    "colors": "^1.4.0",
    "didyoumean": "^1.2.2",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.5",
    "fs-extra": "^11.4.1",
    "gemini-web-sdk": "^2.3.0",
    "got-scraping": "^4.2.1",
    "javascript-obfuscator": "^5.8.0",
    "jimp": "^1.6.0",
    "lowdb": "^3.0.0",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.2.1",
    "pdfkit": "^0.13.0",
    "pino": "^8.15.0",
    "qrcode": "^1.5.3",
    "readline-sync": "^1.4.10",
    "sengkrep-ryna": "^3.3.2",
    "sharp": "^0.35.3",
    "similarity": "^1.2.1",
    "syntax-error": "^1.4.0",
    "tar": "^7.5.22",
    "translate": "^3.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.16.0",
    "yt-search": "^2.10.4",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.4"
  },
  "overrides": {
    "minimatch": "^3.1.5"
  }
}
