# Salin ke bot/.env lalu isi nilainya. JANGAN commit file hasil salinan.
# Semua nilai di bawah hanya contoh bentuk; jangan pakai nilai contoh di produksi.

# ---------------------------------------------------------------- platform
# Kunci induk AES-256-GCM untuk token bot Telegram at-rest (32 byte base64/hex).
# Simpan di secret manager; kalau hilang, token bot tidak bisa dibuka lagi.
PLATFORM_SECRET_KEY=

# Rahasia bersama website (Vercel `PLATFORM_API_SECRET`) untuk memanggil
# /api/platform-system/*. Header x-platform-secret.
PLATFORM_API_SECRET=

# Kunci HMAC untuk tautan media bertanda tangan (e/u/s).
PLATFORM_MEDIA_SIGNING_KEY=

# Alamat publik bot agar URL media bisa dibuka dari luar.
PLATFORM_PUBLIC_BASE_URL=https://api.example.com

# Alamat website untuk tautan balik di pesan bot.
PLATFORM_WEB_URL=https://example.com

# Opsional: lokasi penyimpanan media (default: data/platform/media).
# Banner video yang dikirim saat /menu dibuka di Telegram. Berkas diunduh
# sekali dari URL ini lalu di-cache; setelah itu Telegram memakai file_id.
# PLATFORM_BANNER_URL=https://bot.example.com/api/platform-system/media/xxxx
# PLATFORM_BANNER_FILE=/data/platform/banner/menu.mp4
# PLATFORM_MEDIA_DIR=/var/lib/umi/media

# Opsional: batas sesi jadibot per peran (default di kode).
# PLATFORM_SESSION_LIMIT_USER=1
# PLATFORM_SESSION_LIMIT_RESELLER=3
# PLATFORM_SESSION_LIMIT_ADMIN=5

# ---------------------------------------------------------------- telegram
# Token bot bawaan (opsional). Bot tambahan dikelola lewat panel dan disimpan
# terenkripsi di tabel telegram_bots.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_LABEL=Usanagi Umi
TELEGRAM_MODE=polling

# ID Telegram numerik untuk pemetaan peran (bukan username).
TELEGRAM_OWNER_IDS=
TELEGRAM_DEVELOPER_IDS=
TELEGRAM_ADMIN_IDS=

# Kode claim owner sekali pakai, dipakai lewat /admin claim <kode>.
TELEGRAM_OWNER_CLAIM_CODE=

# ---------------------------------------------------------------- integrasi
# Token game/website yang sama dipakai bot WhatsApp dan bot Telegram.
UMI_GAME_BASE=
UMI_GAME_TOKEN=
GAME_TOKEN=

# Opsional untuk tes lokal: arahkan ke mock Telegram.
# TELEGRAM_API_BASE=https://api.telegram.org

# ---------------------------------------------------------------- terabox
# /terabox membaca share link TeraBox tanpa login. Untuk MENGUNDUH file,
# TeraBox mewajibkan akun — isi cookie `ndus` milik akun gratis di sini
# (atau lewat bot: /tbcookie set ndus=...). Berkas .env.terabox dibuat mode 600.
TERABOX_COOKIE=
# Lokasi berkas cookie bila tidak memakai .env.terabox di direktori kerja.
# UMI_TERABOX_ENV_FILE=

# ---------------------------------------------------------------- pusat error
# Setiap error sistem ditulis ke data/errors/YYYY-MM-DD.jsonl (mode 600) dan
# dikirim ke Telegram. Tujuan notifikasi = TELEGRAM_OWNER_IDS + TELEGRAM_ADMIN_IDS
# (sudah ada di atas). Tambahan chat/grup opsional, pisahkan dengan koma.
# UMI_ERROR_TELEGRAM_CHAT=-100xxxxxxxxxx
# Folder log error alternatif (default <cwd>/data/errors).
# UMI_ERROR_LOG_DIR=
# Basis API Telegram bila memakai mock/proxy.
# UMI_TELEGRAM_API_BASE=https://api.telegram.org
